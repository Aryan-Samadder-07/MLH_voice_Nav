datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

enum Role {
  FARMER
  BUYER
  TRANSPORTER
  ADMIN
}

enum ListingStatus {
  ACTIVE
  OFFER_ACCEPTED
  COMPLETED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TransportStatus {
  UNASSIGNED
  ASSIGNED
  LOADING
  IN_TRANSIT
  DELIVERED
}

enum TransportMode {
  SHARED
  DEDICATED
}

enum TransporterBidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum DisputeType {
  QUALITY
  QUANTITY
  DELAY
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

model User {
  id                 String              @id @default(uuid())
  name               String
  phone              String              @unique
  passwordHash       String
  role               Role
  state              String
  district           String
  perKmRate          Float?              // Custom transporter freight rate per km/quintal
  baseFare           Float?              // Custom base trip fare
  vehicleType        String?             // e.g. Bolero Pickup (1.5T), Eicher 14ft (4T)
  latitude           Float?
  longitude          Float?
  reliabilityScore   Float               @default(5.0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  listings           LotListing[]        @relation("FarmerListings")
  offers             BuyerOffer[]        @relation("BuyerOffers")
  transportJobs      TransportJob[]      @relation("TransporterJobs")
  transporterBids    TransporterBid[]    @relation("TransporterBids")
  transactionsAsBuyer TransactionRecord[] @relation("BuyerTransactions")
  transactionsAsTrans TransporterTransaction[] @relation("TransporterTransactions")
  disputesRaised     DisputeRecord[]     @relation("UserDisputes")
  ratingsGiven       Rating[]            @relation("RatingsGiven")
  ratingsReceived    Rating[]            @relation("RatingsReceived")
}

model LotListing {
  id                 String              @id @default(uuid())
  commodity          String
  variety            String
  weight             Float               // in quintals (100 kg)
  grade              String              // e.g. Grade A, Grade B
  pickupLocation     String
  minPrice           Float               // minimum price per quintal
  latitude           Float?
  longitude          Float?
  status             ListingStatus       @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  farmerId           String
  farmer             User                @relation("FarmerListings", fields: [farmerId], references: [id], onDelete: Cascade)
  offers             BuyerOffer[]
  transportJob       TransportJob?
  transaction        TransactionRecord?
  disputes           DisputeRecord[]
  ratings            Rating[]
}

model BuyerOffer {
  id                 String              @id @default(uuid())
  offeredPrice       Float               // price per quintal
  quantity           Float               // in quintals
  status             OfferStatus         @default(PENDING)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  buyerId            String
  buyer              User                @relation("BuyerOffers", fields: [buyerId], references: [id], onDelete: Cascade)
  lotId              String
  lot                LotListing          @relation(fields: [lotId], references: [id], onDelete: Cascade)
}

model TransportJob {
  id                 String              @id @default(uuid())
  mode               TransportMode       @default(SHARED)
  fee                Float               // estimated or accepted freight fee
  status             TransportStatus     @default(UNASSIGNED)
  distance           Float               // in km
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  transporterId      String?
  transporter        User?               @relation("TransporterJobs", fields: [transporterId], references: [id], onDelete: SetNull)
  lotId              String              @unique
  lot                LotListing          @relation(fields: [lotId], references: [id], onDelete: Cascade)
  bids               TransporterBid[]
}

model TransporterBid {
  id                 String               @id @default(uuid())
  offeredFee         Float                // freight quote
  vehicleType        String
  estimatedEtaHours  Int                  @default(24)
  status             TransporterBidStatus @default(PENDING)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  jobId              String
  job                TransportJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  transporterId      String
  transporter        User                 @relation("TransporterBids", fields: [transporterId], references: [id], onDelete: Cascade)
}

model TransactionRecord {
  id                 String              @id @default(uuid())
  buyerPrice         Float               // total gross payout
  logisticsFee       Float
  platformFee        Float
  netRealization     Float
  createdAt          DateTime            @default(now())
  lotId              String              @unique
  lot                LotListing          @relation(fields: [lotId], references: [id], onDelete: Cascade)
  buyerId            String
  buyer              User                @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: Cascade)
}

model TransporterTransaction {
  id                 String              @id @default(uuid())
  fee                Float
  createdAt          DateTime            @default(now())
  transporterId      String
  transporter        User                @relation("TransporterTransactions", fields: [transporterId], references: [id], onDelete: Cascade)
}

model DisputeRecord {
  id                 String              @id @default(uuid())
  type               DisputeType
  description        String
  status             DisputeStatus       @default(OPEN)
  createdAt          DateTime            @default(now())
  lotId              String
  lot                LotListing          @relation(fields: [lotId], references: [id], onDelete: Cascade)
  raisedById         String
  raisedBy           User                @relation("UserDisputes", fields: [raisedById], references: [id], onDelete: Cascade)
}

model Rating {
  id                 String              @id @default(uuid())
  score              Int                 // 1 to 5 stars
  comment            String?
  createdAt          DateTime            @default(now())
  reviewerId         String
  reviewer           User                @relation("RatingsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  targetUserId       String
  targetUser         User                @relation("RatingsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  lotId              String?
  lot                LotListing?         @relation(fields: [lotId], references: [id], onDelete: SetNull)
}
